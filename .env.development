# 变量必须以 VITE_ 为前缀才能暴露给外部读取

# 项目运行的端口号
VITE_APP_PORT = 5173

# API 基础路径，开发环境下的请求前缀
VITE_APP_BASE_API = '/dev-api'

# API 服务器的 URL
VITE_APP_API_URL = http://localhost:3100

# 简历 PDF 地址（微信小程序端必须是 https 域名且已配置 downloadFile 合法域名；
# 当前指向包内静态资源 src/static/zxj-Resume.pdf，仅 H5 生效）
VITE_RESUME_PDF_URL = /static/zxj-Resume.pdf

VITE_RESUME_PDF_URL= /static/zxj-Resume.pdf