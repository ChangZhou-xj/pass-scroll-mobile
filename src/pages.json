{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^my-(.*)": "@/components/$1.vue",
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^(.*)": "@/components/$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页",
        "enablePullDownRefresh": true,
        "backgroundColor": "#F7F8FA",
        "backgroundColorBottom": "#F7F8FA"
      }
    },
    {
      "path": "pages/review/index",
      "style": {
        "navigationBarTitleText": "随机复习",
        "backgroundColor": "#F7F8FA",
        "backgroundColorBottom": "#F7F8FA"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的",
        "backgroundColor": "#F7F8FA",
        "backgroundColorBottom": "#F7F8FA"
      }
    },
    {
      "path": "pages/onboarding/index",
      "style": {
        "navigationBarTitleText": " ",
        "backgroundColor": "#F7F8FA",
        "backgroundColorBottom": "#F7F8FA"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "backgroundColor": "#F7F8FA",
        "backgroundColorBottom": "#F7F8FA"
      }
    },
    {
      "path": "pages/detail/index",
      "style": {
        "navigationBarTitleText": "详情"
      }
    },
    {
      "path": "pages/versions/index",
      "style": {
        "navigationBarTitleText": "历史版本",
        "backgroundColor": "#F7F8FA",
        "backgroundColorBottom": "#F7F8FA"
      }
    },
    {
      "path": "pages/password/index",
      "style": {
        "navigationBarTitleText": "修改密码",
        "backgroundColor": "#F7F8FA",
        "backgroundColorBottom": "#F7F8FA"
      }
    },
    {
      "path": "pages/editor/index",
      "style": {
        "navigationBarTitleText": "编辑"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "通关秘籍",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#8C8C8C",
    "selectedColor": "#3E63DD",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/review/index",
        "text": "复习",
        "iconPath": "static/tabbar/review.png",
        "selectedIconPath": "static/tabbar/review-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  }
}
